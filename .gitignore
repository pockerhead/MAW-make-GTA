# Rust
/target/
**/*.rs.bk
*.pdb

# MAW runtime state
maw/.reason-active
maw/.reason-last-run

# IDE / OS
.vscode/
.idea/
.DS_Store
*.log

# Agent harness dirs (MAW is reinstalled via install.sh; local pointers live here)
.claude/
.agents/

# MAW per-task scratch and transcripts (probes, raw agent sessions)
maw/tasks/**/scratch/
maw/tasks/**/transcripts/

# Binary / heavy assets (tuning .ron files under assets/ stay tracked)
*.glb
*.gltf
*.bin
*.fbx
*.obj
*.blend
*.blend1
*.png
*.jpg
*.jpeg
*.tga
*.dds
*.ktx2
*.hdr
*.exr
*.psd
*.ogg
*.wav
*.mp3
*.flac
*.ttf
*.otf
*.zip
*.7z
*.tar
*.gz
*.rar
*.exe
*.dll
*.gif
*.mp4
*.webm

# Auto-ignored large files (>5 MB), appended by the orchestrator sync

# Python bytecode
__pycache__/
*.pyc

# Third-party packs: fetched by tools/fetch_assets.py, never committed; only the manifest is tracked
/assets/third_party/*
!/assets/third_party/manifest.ron

# Parallel MAW worktrees
.worktrees/
