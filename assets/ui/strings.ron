(
    font: "third_party/inter/Inter-Regular.ttf",
    title_font: "third_party/inter/InterDisplay-Black.ttf",
    loading: "Генерация города (seed {seed})",
    loading_size: 32.0,
    wasted: "ПОТРАЧЕНО",
    wasted_size: 96.0,
    wasted_color: (0.78, 0.08, 0.08),
    wasted_backdrop: (0.0, 0.0, 0.0, 0.35),
    wasted_saturation: 0.0,
    busted: "BUSTED",
    busted_color: (0.20, 0.45, 1.0),
    damage_crit: "{damage} CRIT",
    hud: (margin: 24.0, bar_width: 200.0, bar_height: 12.0, bar_gap: 6.0,
          health_color: (0.80, 0.15, 0.15), armor_color: (0.25, 0.45, 0.90), back_color: (0.0, 0.0, 0.0, 0.55),
          ammo_size: 22.0, ammo_color: (1.0, 1.0, 1.0), crosshair_dot: 4.0, crosshair_arm: 8.0,
          crosshair_thickness: 2.0, crosshair_color: (1.0, 1.0, 1.0, 0.9), hit_marker_size: 28.0, hit_marker_seconds: 0.1,
          hit_marker_color: (1.0, 1.0, 1.0), kill_marker_color: (0.9, 0.1, 0.1),
          // Over a civilian phoning the police: px size, metres above the head top, colours.
          witness_bar: (width: 48.0, height: 6.0, head_offset: 0.35,
                        fill_color: (1.0, 0.85, 0.2), back_color: (0.0, 0.0, 0.0, 0.55)),
          // Wanted stars: white while a cop sees the player, blinking grey/dim grey while unseen (GDD §6.4).
          // Earned stars carry a dark drop shadow in every phase, empty slots are a faint light ghost
          // with none: countable on sky, light walls and asphalt alike.
          stars: (glyph: "★", size: 26.0, gap: 2.0, lit_color: (1.0, 1.0, 1.0),
                  gray_color: (0.72, 0.72, 0.72), dim_color: (0.40, 0.40, 0.40),
                  off_color: (1.0, 1.0, 1.0, 0.25), blink_seconds: 0.25,
                  shadow_offset: 2.0, shadow_color: (0.0, 0.0, 0.0, 0.9)),
          // Round minimap bottom-left (GDD §7): px size, metres from centre to rim, raster texels per metre (<= 2).
          // Map colours are sRGB; territories are the gang tints (gang/gangs.ron) at territory_alpha.
          // Cop cones use wanted.ron cop_view_distance / cop_view_cone_deg; police dots use visual.ron police_tint.
          minimap: (size: 220.0, view_radius: 120.0, raster_px_per_m: 1.0,
                    road: (0.16, 0.16, 0.18), sidewalk: (0.42, 0.42, 0.44), block: (0.30, 0.31, 0.33),
                    park: (0.22, 0.42, 0.22), building: (0.55, 0.55, 0.58), outside: (0.05, 0.05, 0.06, 1.0),
                    territory_alpha: 0.35, rim_color: (0.0, 0.0, 0.0, 0.85), rim_px: 3.0,
                    search_fill: (0.35, 0.55, 1.0, 0.15), search_ring: (0.75, 0.85, 1.0, 0.9), search_ring_px: 2.0,
                    cone_color: (1.0, 0.2, 0.2, 0.25), arrow_color: (1.0, 1.0, 1.0), arrow_px: 14.0, dot_px: 7.0,
                    pickup_color: (0.3, 1.0, 0.4), hospital: ("+", (1.0, 0.35, 0.35)), station: ("П", (0.45, 0.65, 1.0)),
                    glyph_size: 18.0)),
    // Main menu (no --seed), pause menu (Esc) and settings screen. current_seed must contain {seed}; *_value must contain {value}.
    // Every character here must exist in both Inter fonts: python tools/qa/font_check.py.
    // sensitivity_range: (min, max, step) of the mouse sensitivity multiplier; volume_step: one press (volume 0..1).
    menu: (title: "GTA-like", new_game: "Новая игра", seed_label: "Seed:", seed_hint: "Enter — город с этим seed, пусто — случайный",
           quit: "Выход", paused: "ПАУЗА", current_seed: "Seed города: {seed}", resume: "Продолжить",
           new_city: "Новый город", settings: "Настройки", back: "Назад", sensitivity: "Чувствительность мыши",
           volume: "Громкость", invert_y: "Инверсия Y", reduce_shake: "Уменьшить тряску",
           reduce_camera_motion: "Меньше движения камеры", no_flashes: "Без вспышек",
           on: "вкл", off: "выкл", step_down: "−", step_up: "+", toggle: "↔",
           sensitivity_value: "×{value}", volume_value: "{value}%",
           title_size: 72.0, item_size: 26.0, item_gap: 14.0, button_width: 320.0, button_height: 48.0,
           backdrop: (0.0, 0.0, 0.0, 0.6), menu_backdrop: (0.06, 0.07, 0.09, 1.0),
           button_color: (0.15, 0.16, 0.2, 0.9), button_hover_color: (0.3, 0.32, 0.4, 0.95),
           text_color: (1.0, 1.0, 1.0), field_color: (0.1, 0.1, 0.12, 1.0),
           sensitivity_range: (0.25, 3.0, 0.25), volume_step: 0.1),
)
