// Car crash and bullet damage (GDD §5.2).
(
    // Car health; crash loss = (closing speed - threshold_speed)·per_mps. 10 m/s -> 200, 28 m/s -> 920.
    // bullet_scale: multiplier on a weapon's base damage per pellet that hits the body.
    // scrape_normal: a contact normal with at least this share along the car's down axis is an
    // underbody scrape, not a crash (0.5 = within 60° of straight down; the nose chamfer is 0.86).
    vehicle: (
        max_health: 1000.0,
        threshold_speed: 5.0,
        per_mps: 40.0,
        bullet_scale: 1.0,
        scrape_normal: 0.5,
        // Share of a cabin pellet's base damage the seated driver takes (sedan.ron `cabin`).
        cabin_driver_share: 0.5,
    ),
    // Pedestrian hit: loss = (closing speed - threshold_speed)·per_mps, 10 m/s -> 84 (one hit kills from
    // 11.3 m/s). player_share: the player takes this share of it: traffic cruise 16 m/s -> 62, running
    // head-on into it (16 + 4.5) -> 84, so a full-health player survives; 28 m/s -> 120 kills.
    // knockdown_speed, m/s; shove_scale: knockback velocity per m/s of closing speed, >= 0.8 throws the
    // body clear of a cruising car (below it the car rolls on into the knocked-down body and hits again).
    pedestrian: (threshold_speed: 3.0, per_mps: 12.0, knockdown_speed: 4.0, shove_scale: 1.0, player_share: 0.4),
)
