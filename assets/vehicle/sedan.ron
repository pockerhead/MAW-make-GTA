// Raycast sedan (GDD §5.1). Body frame: x right, y up, forward -Z. Kenney Car Kit sedan x render
// scale 1.6. Derived numbers below use g = 9.81 m/s².
(
    // kg. Chassis density = mass / collider volume (2.4 x (1.84 - 0.2) x 4.08 - 2.4 x 0.5 x 0.3
    // = 15.699 m³) = 76.4 kg/m³.
    mass: 1200.0,
    // Half extents of the chassis box, m.
    chassis_half_extents: (1.2, 0.92, 2.04),
    // Chassis collider underside, m: the box bottom raised by `lift`, the lower nose and tail cut
    // `chamfer_length` along and `chamfer_height` up. Ground clearance at rest = 1.1596 - 0.92 +
    // lift = 0.44 m, 0.29 m over a 0.15 m curb: the wheels climb it, the nose clears it.
    underbody: (lift: 0.2, chamfer_length: 0.5, chamfer_height: 0.3),
    // Centre of mass relative to the box centre, m: 0.66 m above the road at rest (rollover SSF).
    center_of_mass: (0.0, -0.5, 0.0),
    // Wheel hubs at (±half_track, _, ±half_wheelbase), radius 0.3 x 1.6. mount_height: top of the
    // suspension travel below the chassis centre, m = hub at rest -0.68 + spring length at rest 0.1896.
    wheels: (half_track: 0.72, half_wheelbase: 1.06, mount_height: -0.49, radius: 0.48),
    // travel, m; frequency, Hz; damping ratio. k = (m/4)(2πf)² = 26 648 N/m,
    // c = ζ·2·√(k·m/4) = 2 262 N·s/m on the compression rate, static compression g/(2πf)² = 0.1104 m.
    // Rest height of the chassis centre = -mount_height + travel - 0.1104 + radius = 1.1596 m.
    // max_damper_speed, m/s: the damper sees the compression rate clamped to ±this. The wheel ray
    // sees a 0.15 m curb as a compression jump within one tick (9.6 m/s): unclamped, a 28 kN kick
    // per wheel; at 0.5 the peak is 8.2 kN (spring 6.9 + c·0.5). Settling (≤ 0.5 m/s) is unchanged.
    suspension: (travel: 0.3, frequency_hz: 1.5, damping_ratio: 0.4, max_damper_speed: 0.5),
    // Top speed, m/s (100 km/h).
    max_speed: 28.0,
    // Drive acceleration, m/s²: 0 -> 27.8 m/s in about 6 s.
    acceleration: 4.6,
    // Drive force fades to zero over this band below max_speed, m/s.
    top_speed_band: 2.0,
    // Reverse top speed, m/s.
    reverse_speed: 6.0,
    // Brake deceleration, m/s².
    brake_deceleration: 9.0,
    // Rolling deceleration with no throttle, m/s².
    coast_deceleration: 1.0,
    // Below this speed with no throttle the tyres hold the car still, m/s.
    hold_speed: 0.5,
    // Front wheel steer angle at rest and at max_speed, degrees; turn rate of the wheel, degrees/s.
    steer: (max_deg: 32.0, at_max_speed_deg: 6.0, rate_deg_per_s: 180.0),
    // Friction coefficient caps the tyre force at mu·N; front/rear scale the lateral grip;
    // handbrake_rear scales the rear grip while the handbrake is held.
    grip: (mu: 1.1, front: 1.0, rear: 1.0, handbrake_rear: 0.25),
    // Share of the tyre force lever arm below the centre of mass (0 = applied at the CoM height,
    // 1 = at the contact). 0.3: lever 0.198 m, static stability factor 3.6 (no rollover).
    roll_influence: 0.3,
    // Driver seat (player body centre) and the left door point, body frame, m.
    seat: (-0.45, 0.2, 0.1),
    door: (-1.7, 0.0, -0.3),
    // The player enters when its flat distance to the door point is at most this, m.
    enter_radius: 2.5,
    // Entry and exit are allowed only at or below this car speed, m/s.
    exit_max_speed: 3.0,
    // Cabin zone, body frame, m: a bullet hitting the body inside it reaches the seated driver. The
    // x half extent and the top reach past the chassis (1.2 / 0.92), so hits on the surface count.
    cabin: (centre: (0.0, 0.45, 0.1), half_extents: (1.25, 0.5, 1.0)),
    // AI driving (traffic after a contact, police cars): pure pursuit to a target lookahead_min +
    // lookahead_per_mps x speed ahead (m, s); throttle = speed error x speed_gain; below stuck_speed
    // (m/s) with the throttle open for stuck_seconds the car backs up for reverse_seconds.
    autopilot: (lookahead_min: 4.0, lookahead_per_mps: 0.5, speed_gain: 0.5, stuck_speed: 0.5,
                stuck_seconds: 2.0, reverse_seconds: 1.5),
)
