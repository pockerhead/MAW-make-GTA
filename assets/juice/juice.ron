(
    recoil_deg: (pistol: 1.0, smg: 0.5, shotgun: 2.0),
    recoil_half_life: 0.08,
    hit_stop_seconds: 0.05,     // s, real time: attacker and target animations freeze on a melee hit
    shake: (
        melee_trauma: 0.25,     // trauma added when the player lands or takes a melee hit (0..1)
        decay_per_s: 1.2,       // trauma lost per real second
        max_yaw_deg: 3.0,       // camera rotation at trauma 1 (scaled by trauma^2)
        max_pitch_deg: 3.0,
        max_roll_deg: 5.0,
        noise_hz: 15.0,         // noise lattice steps per second
        reduced_scale: 0.3,     // share of the shake left with the "reduce shake" setting (0..1)
        shot_trauma: 0.1,       // trauma added by a shot the player fires (0..1)
        hurt_trauma: 0.2,       // trauma added by each hit that lowers the player's health or armour (0..1)
        death_trauma: 0.4,      // trauma added by a kill near the player (0..1)
        death_radius: 12.0,     // m from the player within which a kill adds death_trauma
        crash_trauma_per_mps: 0.02, // trauma per m/s of a crash of the player's car (clamped at 1)
        crash_min_speed: 5.0,   // m/s: slower crashes add no trauma
    ),
    flash: (seconds: 0.05, size: 0.25, color: (1.0, 0.8, 0.4), light_intensity: 100000.0, light_range: 6.0),
    tracer: (seconds: 0.1, width: 0.05, color: (1.0, 0.9, 0.6)),
    damage_numbers: (
        lifetime: 0.8,          // s, real time
        pop_seconds: 0.08,      // s, scale eases from pop_start_scale to 1
        pop_start_scale: 1.8,   // <1 = grow-in, >1 = punch-in
        rise_px: 60.0,          // total upward travel, ease-out cubic
        drift_px: 24.0,         // max sideways travel, linear
        fade_start: 0.5,        // fraction of lifetime where alpha starts falling to 0
        size: 26.0,             // font px, body hit
        crit_size: 38.0,        // font px, headshot
        color: (1.0, 1.0, 1.0),
        crit_color: (0.95, 0.12, 0.12),
    ),
    camera_motion_reduced_scale: 0.3,   // share of the recoil kick left with "reduce camera motion" (0..1)
    vignette: (
        color: (0.75, 0.0, 0.0),
        per_hurt: 0.45,         // intensity added per hit taken
        max: 0.65,              // intensity cap (0..1]; sustained fire (~2.7 hits/s) reaches it in ~1 s
        decay_per_s: 0.45,      // intensity lost per real second: one hit stays readable ~1 s
        radius: 0.85,           // size of the clear centre (bevy Vignette radius)
        smoothness: 2.0,        // edge softness (bevy Vignette smoothness); lower keeps the tint at the edges
    ),
    damage_arc: (
        seconds: 0.6,           // s, real time; fades out over it
        radius_px: 150.0,       // px, ring around the screen centre
        thickness_px: 6.0,      // px
        color: (0.9, 0.1, 0.1),
    ),
    star_pulse: (
        scale: 1.3,             // wanted-star row scale when the level rises (> 1)
        seconds: 0.35,          // s, real time, back to scale 1 (ease back-out)
    ),
    // Wrecked car (health 0): a puff every `interval` s from `hood` (body frame, m), rising `rise` m and
    // fading over `seconds` (real time); size = diameter, m; color = sRGB + starting alpha.
    smoke: (interval: 0.25, seconds: 1.2, size: 0.5, rise: 1.2, color: (0.25, 0.25, 0.25, 0.6),
            hood: (0.0, 0.6, -1.6)),
)
