(
    pivot_height: 1.55,
    shoulder_offset: 0.8,
    distance: 3.8,
    fov_deg: 70.0,
    pitch_min_deg: -70.0,
    pitch_max_deg: 60.0,
    mouse_sensitivity_deg: 0.12,
    follow_half_life: 0.05,
    collision_radius: 0.25,
    collision_release_half_life: 0.25,
    aim_shoulder_offset: 1.0,
    aim_distance: 2.6,
    aim_fov_deg: 55.0,
    aim_transition: 0.15,
    aim_sensitivity_scale: 0.7,
    // Car camera (GDD §5.1): distance and pivot height over the car centre, m; resting pitch, deg;
    // half-life of the swing back behind the car, s; mouse-idle seconds before it swings back.
    car_distance: 6.5,
    car_pivot_height: 1.0,
    car_pitch_deg: -8.0,
    car_yaw_half_life: 0.2,
    car_look_return: 1.5,
    // Camera pushed into the player (back to a wall): hide the model below this camera-to-body
    // distance, m; show it again only past distance + band (no flicker at the threshold).
    hide_player_distance: 1.4,
    hide_player_band: 0.3,
)
